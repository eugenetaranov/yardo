#!/bin/sh
# mcp-sync — register MCP servers into the local MCPJungle gateway.
#
#   mcp-sync [name ...]    enable these servers (saved to ~/.mcp/servers), then sync
#   mcp-sync               sync the saved list plus every ~/.mcp/<name>/spec
#   mcp-sync edit <name>   edit a server's credentials (~/.mcp/<name>/env)
#   mcp-sync rename <name> <new>  rename a server (deregistered; run mcp-sync to register it)
#   mcp-sync remove <name> deregister a server and delete its ~/.mcp/<name> (its settings)
#   mcp-sync off [name ...]  turn these servers off (none named: all of them): they stay
#                          registered, with their settings, but the gateway hides their
#                          tools from every client (~/.mcp/<name>/off, ~/.mcp/off)
#   mcp-sync on [name ...] turn them on again (none named: all, each back to its own choice)
#   mcp-sync restart [name ...]  start these servers afresh (none named: every one):
#                          deregistered, their Docker containers removed (none named:
#                          every container of ~/.mcp, those the gateway lost included),
#                          then synced: registered again, off ones still off
#   mcp-sync status        each server's state, a line each: <name> TAB <state> TAB <detail>
#                          (ok, waiting <keys>, changed, unregistered, failed <why>,
#                          nospec, noenv, off <own|all>, refused <option>: Docker options
#                          that would let it act on the host; "-  down" first when the gateway
#                          can't be reached, "*  off" when all servers are off)
#   mcp-sync source [name ...]  where each server runs from, a line each:
#                          <name> TAB <image or URL> [TAB <version> TAB <id> TAB <built>]
#                          (the last three for an image pulled here)
#   mcp-sync client <name> make a token for another MCP client (a laptop's agent), allowed
#                          every server, in ~/.mcp/clients/<name>.token (not printed);
#                          only when the gateway listens beyond this machine
#   mcp-sync client-rm <name>  revoke that client's token: the gateway forgets the
#                          client, and its token and conf files are deleted
#
# When yardo runs the gateway as a service user (mcp-<you>, which
# owns ~/.mcp so agents running as you can't read the tokens), this re-runs
# itself as that user through sudo. Nothing of the caller's environment
# crosses over: the home comes from the passwd entry, the catalog and the
# gateway's address are fixed, and the editor is a system one. (Else
# anyone running as you, a coding agent included, could have the service
# user source a spec of theirs, or send the tokens to a gateway of theirs.)
#
# Each server gets ~/.mcp/<name>/ (mode 700) holding its credentials in `env`
# (KEY=value lines, no quotes). Docker servers read that file at start; it is
# also mounted read-only at /mcp for servers that need extra files, and a
# spec's MOUNT_AWS=1 mounts your ~/.aws (AWS), MOUNT_KUBE=1 your ~/.kube
# (Kubernetes). A server is registered once its required keys are filled in, and
# re-registered when its generated config changes. Servers dropped from the
# list are deregistered.
set -eu

me=$(id -un)
# This user's gateway port (yardo gives each user their own), and the
# address it listens on (all interfaces: reached here on loopback).
port=$(sed -n 's/^MCP_PORT=//p' "/etc/mcpjungle/$me.env" 2>/dev/null || true)
host=$(sed -n 's/^MCP_HOST=//p' "/etc/mcpjungle/$me.env" 2>/dev/null || true)
case "$host" in ''|0.0.0.0) host=127.0.0.1 ;; esac
# system_editor — the editor to edit as the service user with: yours when
# it's one of the usual ones installed for everyone, else vim, else vi.
system_editor() {
  for e in "${VISUAL:-}" "${EDITOR:-}" vim vi; do
    case "${e##*/}" in
      vim|vi|nvim|nano|emacs|micro|hx|mcedit) ;;
      *) continue ;;
    esac
    for d in /usr/bin /bin /usr/local/bin; do
      [ -x "$d/${e##*/}" ] && { echo "$d/${e##*/}"; return; }
    done
  done
  echo vi
}

if [ -z "${MCP_DIR:-}" ] && id "mcp-$me" >/dev/null 2>&1; then
  # The gateway's own record of its directory (root's), else the home's.
  dir=$(sed -n 's/^MCP_DIR=//p' "/etc/mcpjungle/$me.env" 2>/dev/null || true)
  if [ -z "$dir" ]; then
    home=$(getent passwd "$me" | cut -d: -f6)
    [ -n "$home" ] || { echo "mcp-sync: no home for $me" >&2; exit 1; }
    dir=$home/.mcp
  fi
  self=/usr/local/bin/mcp-sync
  [ -x "$self" ] || self=$0
  exec sudo -u "mcp-$me" env MCP_DIR="$dir" \
    MCP_CATALOG=/usr/local/share/mcp-catalog \
    MCPJUNGLE_REGISTRY="http://$host:${port:-8080}" \
    EDITOR="$(system_editor)" "$self" "$@"
fi

MCP_DIR="${MCP_DIR:-$HOME/.mcp}"
# The CLI reads the gateway's admin token (in enterprise mode) from
# $HOME/.mcpjungle.conf: the one in ~/.mcp, the service user's.
mj() { HOME="$MCP_DIR" mcpjungle "$@"; }
CATALOG="${MCP_CATALOG:-/usr/local/share/mcp-catalog}"
REGISTRY="${MCPJUNGLE_REGISTRY:-http://$host:${port:-8080}}"

umask 077
mkdir -p "$MCP_DIR"
chmod 700 "$MCP_DIR"

# valid_name NAME — a server name: a directory under $MCP_DIR, a gateway
# server name and its tools' prefix (<name>__<tool>).
valid_name() {
  case "$1" in
    ''|.*|-*|*[!A-Za-z0-9._-]*|*..*|*__*) return 1 ;;
  esac
  [ "${#1}" -le 64 ]
}

if [ "${1:-}" = edit ]; then
  valid_name "${2:-}" || { echo "usage: mcp-sync edit <server>" >&2; exit 2; }
  mkdir -p "$MCP_DIR/$2"
  chmod 700 "$MCP_DIR/$2"
  [ -f "$MCP_DIR/$2/env" ] || : > "$MCP_DIR/$2/env"
  chmod 600 "$MCP_DIR/$2/env"
  "${EDITOR:-vi}" "$MCP_DIR/$2/env"
  [ -n "${MCP_SYNC_QUIET:-}" ] || echo "Now run mcp-sync to register it (or: sudo yardo mcp sync)."
  exit 0
fi

if [ "${1:-}" = client ]; then
  case "${2:-}" in
    ''|.*|*/*|*[!A-Za-z0-9._-]*) echo "usage: mcp-sync client <name>" >&2; exit 2 ;;
  esac
  [ -f "$MCP_DIR/.mcpjungle.conf" ] || {
    echo "mcp-sync: the gateway listens on this machine only, with no tokens: choose another address in 'sudo yardo' first" >&2
    exit 1
  }
  # The token goes to a file, never the screen: from there the CLI reads it
  # (on the command line, ps would show it), and you, with sudo.
  tok="$MCP_DIR/clients/$2.token"
  [ ! -e "$tok" ] || { echo "mcp-sync: there's a $2 already; its token: sudo cat $tok" >&2; exit 1; }
  (umask 077; mkdir -p "$MCP_DIR/clients"; od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$tok"; echo >> "$tok")
  printf '{"name": "%s", "description": "%s (mcp-sync client)", "allowed_servers": ["*"], "access_token_ref": {"file": "%s"}}\n' \
    "$2" "$2" "$tok" > "$MCP_DIR/clients/$2.json"
  # One made before its token had a file (this once printed it): the new
  # token replaces it.
  if mj --registry "$REGISTRY" list mcp-clients 2>/dev/null | grep -Eq "^[0-9]+\. $(printf '%s' "$2" | sed 's/[.]/\\./g')\$"; then
    mj --registry "$REGISTRY" delete mcp-client "$2" >/dev/null || true
  fi
  if ! mj --registry "$REGISTRY" create mcp-client --conf "$MCP_DIR/clients/$2.json" >/dev/null; then
    rm -f "$tok" "$MCP_DIR/clients/$2.json"
    echo "mcp-sync: the gateway didn't make $2" >&2
    exit 1
  fi
  echo "$2's token is in $tok (read it with: sudo cat $tok)."
  echo "Send it as the header 'Authorization: Bearer <token>' to $REGISTRY/mcp (from another machine, use this machine's address)."
  exit 0
fi

if [ "${1:-}" = client-rm ]; then
  case "${2:-}" in
    ''|.*|*/*|*[!A-Za-z0-9._-]*) echo "usage: mcp-sync client-rm <name>" >&2; exit 2 ;;
  esac
  tok="$MCP_DIR/clients/$2.token"
  [ -e "$tok" ] || [ -e "$MCP_DIR/clients/$2.json" ] || { echo "mcp-sync: there's no client $2" >&2; exit 1; }
  # Off the gateway first: a token left in a file but still accepted
  # would be worse than one deleted.
  if mj --registry "$REGISTRY" list mcp-clients 2>/dev/null | grep -Eq "^[0-9]+\. $(printf '%s' "$2" | sed 's/[.]/\\./g')\$"; then
    if ! mj --registry "$REGISTRY" delete mcp-client "$2" >/dev/null; then
      echo "mcp-sync: the gateway didn't forget $2; its token still works" >&2
      exit 1
    fi
  fi
  rm -f "$tok" "$MCP_DIR/clients/$2.json"
  echo "$2's token is revoked: the gateway refuses it."
  exit 0
fi

# cleanup [name ...] — remove these servers' Docker containers (those
# mounting ~/.mcp/<name> at /mcp; none named: every server's). The gateway
# runs them with --rm, but a session it drops leaves its container running.
cleanup() {
  command -v docker >/dev/null 2>&1 || return 0
  ids=$(docker ps -q --no-trunc 2>/dev/null) || return 0
  [ -n "$ids" ] || return 0
  # shellcheck disable=SC2086 # one id a word
  docker inspect --format '{{.Id}}{{range .Mounts}}{{if eq .Destination "/mcp"}} {{.Source}}{{end}}{{end}}' $ids 2>/dev/null |
    while read -r id src; do
      n=${src#"$MCP_DIR"/}
      case "$n" in "$src"|''|*/*) continue ;; esac
      if [ $# -gt 0 ]; then
        case " $* " in *" $n "*) ;; *) continue ;; esac
      fi
      docker rm -f "$id" >/dev/null 2>&1 && printf '%s: removed container %.12s\n' "$n" "$id"
    done || :
}

# forget NAME — take NAME off the gateway (when it was registered) and off
# ~/.mcp/servers, its containers removed.
forget() {
  if [ -f "$MCP_DIR/$1/.registered.json" ]; then
    mj --registry "$REGISTRY" deregister "$1" >/dev/null 2>&1 || true
    rm -f "$MCP_DIR/$1/.registered.json" "$MCP_DIR/$1/.disabled"
  fi
  cleanup "$1"
  [ -f "$MCP_DIR/servers" ] && { grep -vx -- "$1" "$MCP_DIR/servers" > "$MCP_DIR/servers.new" || true; mv -f "$MCP_DIR/servers.new" "$MCP_DIR/servers"; }
  return 0
}

# is_off NAME — NAME is turned off: by itself, or with all of them.
is_off() { [ -f "$MCP_DIR/off" ] || [ -f "$MCP_DIR/$1/off" ]; }

# reconcile — the gateway's servers on or off as the markers say. A server
# registered while off is disabled on the gateway, and .disabled says so
# (registering enables it again, and drops .disabled); one turned on again
# is enabled. Returns 1 when the gateway didn't take a change (then the
# next sync tries again).
reconcile() {
  rc=0
  for reg in "$MCP_DIR"/*/.registered.json; do
    [ -f "$reg" ] || continue
    n=$(basename "$(dirname "$reg")")
    if is_off "$n"; then
      [ -f "$MCP_DIR/$n/.disabled" ] && continue
      if mj --registry "$REGISTRY" disable server "$n" >/dev/null 2>&1; then : > "$MCP_DIR/$n/.disabled"; else rc=1; fi
    elif [ -f "$MCP_DIR/$n/.disabled" ]; then
      if mj --registry "$REGISTRY" enable server "$n" >/dev/null 2>&1; then rm -f "$MCP_DIR/$n/.disabled"; else rc=1; fi
    fi
  done
  return "$rc"
}

if [ "${1:-}" = off ] || [ "${1:-}" = on ]; then
  what=$1; shift
  for n in "$@"; do
    valid_name "$n" || { echo "mcp-sync: not a server name: $n" >&2; exit 2; }
  done
  if [ $# -eq 0 ]; then
    if [ "$what" = off ]; then : > "$MCP_DIR/off"; else rm -f "$MCP_DIR/off"; fi
    echo "all servers: $what"
  else
    for n in "$@"; do
      if [ "$what" = off ]; then
        mkdir -p "$MCP_DIR/$n"; chmod 700 "$MCP_DIR/$n"; : > "$MCP_DIR/$n/off"
      else
        rm -f "$MCP_DIR/$n/off"
      fi
      echo "$n: $what"
    done
  fi
  reconcile || echo "The gateway didn't answer: it takes effect once the gateway runs (the next sync)."
  exit 0
fi

if [ "${1:-}" = rename ]; then
  { valid_name "${2:-}" && valid_name "${3:-}"; } || { echo "usage: mcp-sync rename <server> <new name>" >&2; exit 2; }
  [ -e "$MCP_DIR/$3" ] && { echo "mcp-sync: there's a $3 already" >&2; exit 1; }
  forget "$2"
  [ -d "$MCP_DIR/$2" ] && mv -- "$MCP_DIR/$2" "$MCP_DIR/$3"
  echo "$2 is $3 now; run mcp-sync to register it."
  exit 0
fi

if [ "${1:-}" = remove ]; then
  valid_name "${2:-}" || { echo "usage: mcp-sync remove <server>" >&2; exit 2; }
  forget "$2"
  rm -rf -- "${MCP_DIR:?}/$2"
  echo "$2: removed, with its settings."
  exit 0
fi

# restart: deregistered and their containers gone, the sync below
# registers them again (the saved list as it was: no names left for it).
if [ "${1:-}" = restart ]; then
  shift
  for n in "$@"; do
    valid_name "$n" || { echo "mcp-sync: not a server name: $n" >&2; exit 2; }
  done
  mj --registry "$REGISTRY" list servers >/dev/null 2>&1 || {
    echo "cannot reach the MCPJungle gateway at $REGISTRY" >&2; exit 1; }
  if [ $# -eq 0 ]; then
    for reg in "$MCP_DIR"/*/.registered.json; do
      [ -f "$reg" ] && set -- "$@" "$(basename "$(dirname "$reg")")"
    done
    all=1
  fi
  for n in "$@"; do
    mj --registry "$REGISTRY" deregister "$n" >/dev/null 2>&1 || true
    rm -f "$MCP_DIR/$n/.registered.json" "$MCP_DIR/$n/.disabled"
  done
  if [ -n "${all:-}" ]; then cleanup; else cleanup "$@"; fi
  set --
fi

STATUS=
[ "${1:-}" = status ] && { STATUS=1; shift; }
SOURCE=
[ "${1:-}" = source ] && { SOURCE=1; shift; }

if [ $# -gt 0 ] && [ -z "$STATUS$SOURCE" ]; then
  for n in "$@"; do
    valid_name "$n" || { echo "mcp-sync: not a server name: $n" >&2; exit 2; }
  done
  printf '%s\n' "$@" > "$MCP_DIR/servers"
fi

# envget KEY FILE — value of the last KEY=... line (comments ignored).
envget() { sed -n "s/^$1=//p" "$2" 2>/dev/null | tail -n 1; }

# spec_for NAME — the spec to source for NAME: its own ~/.mcp/<name>/spec
# (a file only this user can write, or a link into the catalog: a link
# leading anywhere else is refused), else the catalog's.
spec_for() {
  s="$MCP_DIR/$1/spec"
  if [ -L "$s" ]; then
    cat=$(cd "$CATALOG" 2>/dev/null && pwd -P) || return 0
    t=$(readlink -f "$s" 2>/dev/null) || return 0
    case "$t" in
      "$cat"/*.spec) [ -f "$t" ] && echo "$t" ;;
      *) echo "$1: its spec links outside $CATALOG — skipped" >&2 ;;
    esac
  elif [ -f "$s" ]; then echo "$s"
  elif [ -f "$CATALOG/$1.spec" ]; then echo "$CATALOG/$1.spec"
  fi
}

enabled() {
  { [ -f "$MCP_DIR/servers" ] && grep -v '^[[:space:]]*\(#\|$\)' "$MCP_DIR/servers"
    for s in "$MCP_DIR"/*/spec; do { [ -f "$s" ] || [ -L "$s" ]; } && basename "$(dirname "$s")"; done
  } | sort -u | while read -r n; do
    if valid_name "$n"; then echo "$n"; else echo "mcp-sync: not a server name, skipped: $n" >&2; fi
  done
}

# refusal NAME SPEC — why the spec's DOCKER_ARGS can't be run, if they
# can't: the first option that would let the container act on the host
# (root, in effect, as the docker group is). Empty when they're fine. Only
# DOCKER_ARGS go to docker; IMAGE_ARGS and image_args() go to the server.
# yardo's own catalog specs (not a team's, not one in ~/.mcp) may name what
# they need beyond that in HOST_ACCESS: docker-socket (the Docker server),
# host-network (a database on this machine at 127.0.0.1).
refusal() {
  _name=$1 _allow=
  _cat=$(cd "$CATALOG" 2>/dev/null && pwd -P) || _cat=$CATALOG
  case "$2" in
    "$CATALOG"/*.spec|"$_cat"/*.spec) grep -qx "${2##*/}" "$CATALOG/.team-files" 2>/dev/null || _allow=" ${HOST_ACCESS:-} " ;;
  esac
  set -f
  # shellcheck disable=SC2086 # split as render splits them
  set -- ${DOCKER_ARGS:-}
  set +f
  while [ $# -gt 0 ]; do
    a=$1; shift
    case "$a" in
      --*=*) opt=${a%%=*} val=${a#*=} ;;
      -[vp]?*) opt=$(printf %.2s "$a") val=${a#??} ;;
      *) opt=$a val= ;;
    esac
    case "$opt" in
      --privileged) [ "$val" = false ] || { echo "$a"; return; } ;;
      --cap-add|--device|--device-cgroup-rule|--volumes-from|--gpus|-p|-P|--publish|--publish-all)
        echo "$opt"; return ;;
      --network|--net|--pid|--ipc|--uts|--userns|--cgroupns|--security-opt|-v|--volume|--mount)
        if [ -z "$val" ] && [ $# -gt 0 ]; then val=$1; shift; fi
        case "$opt=$val" in
          --security-opt=*unconfined*|--security-opt=label[=:]disable) echo "$opt $val"; return ;;
          --security-opt=*) ;;
          -v=*|--volume=*)
            case "$_allow:${val%%:*}" in *" docker-socket "*:/var/run/docker.sock|*" docker-socket "*:/run/docker.sock) continue ;; esac
            bad_source "$_name" "${val%%:*}" && { echo "$opt $val"; return; } ;;
          --mount=*)
            src=$(printf '%s\n' "$val" | tr ',' '\n' | sed -n -e 's/^source=//p' -e 's/^src=//p' | head -n 1)
            bad_source "$_name" "$src" && { echo "$opt $val"; return; } ;;
          --network=host|--net=host) case "$_allow" in *" host-network "*) ;; *) echo "$opt $val"; return ;; esac ;;
          *=host|*=container:*) echo "$opt $val"; return ;;
        esac ;;
    esac
  done
  return 0
}

# bad_source NAME PATH — PATH, a mount's source, is the host's: /, a
# system folder, the Docker socket, or a home (but NAME's own ~/.mcp/NAME).
# A named volume (no leading /) is the container's own.
bad_source() {
  case "$2" in
    /*) ;;
    *) return 1 ;;
  esac
  p=$(printf '%s' "$2" | sed 's://*:/:g; s:/$::')
  case "/$p/" in */../*|*/./*) return 0 ;; esac
  case "$p" in
    "$MCP_DIR/$1"|"$MCP_DIR/$1"/*) return 1 ;;
    ''|*docker.sock) return 0 ;;
  esac
  for d in /etc /root /home /dev /proc /sys /boot /run /var/run /var/lib/docker /usr /bin /sbin /lib /lib64 /opt "$(dirname "$MCP_DIR")"; do
    case "$p" in "$d"|"$d"/*) return 0 ;; esac
  done
  return 1
}

# kube_path KUBECONFIG HOME — KUBECONFIG (paths split by ':') with each
# path under ~/.kube (~/, $HOME/ or HOME/) the one it has in the container.
kube_path() {
  printf '%s\n' "$1" | tr ':' '\n' | while IFS= read -r p; do
    case "$p" in
      '~/.kube/'*|'$HOME/.kube/'*|'${HOME}/.kube/'*) p="/aws/.kube/${p#*/.kube/}" ;;
      "$2/.kube/"*) p="/aws/.kube/${p#"$2"/.kube/}" ;;
    esac
    printf '%s\n' "$p"
  done | paste -sd: -
}

# render NAME — print the MCPJungle JSON config for NAME (spec vars in scope).
render() {
  dir="$MCP_DIR/$1"
  case "$KIND" in
    docker)
      # DOCKER_ARGS go before the image, IMAGE_ARGS (the server's command
      # or flags) after it.
      set -- run -i --rm --env-file "$dir/env" -v "$dir:/mcp:ro"
      # MOUNT_AWS: the owner's ~/.aws (profiles, SSO logins), read-only,
      # as them (its files are theirs, 0600). The home is the one ~/.mcp
      # is in, never a path from the env file: that's the user's to edit,
      # and docker would mount anything. No ~/.aws, no mount (docker would
      # make one, root's).
      # MOUNT_KUBE: their ~/.kube the same way, and a KUBECONFIG of the env
      # file's under it (~/.kube/...) made the path it has in there.
      home=$(dirname "$MCP_DIR") as_home=
      if [ "${MOUNT_AWS:-}" = 1 ] && [ -d "$home/.aws" ]; then
        set -- "$@" -v "$home/.aws:/aws/.aws:ro"; as_home=1
      fi
      if [ "${MOUNT_KUBE:-}" = 1 ] && [ -d "$home/.kube" ]; then
        set -- "$@" -v "$home/.kube:/aws/.kube:ro"; as_home=1
        kc=$(envget KUBECONFIG "$dir/env")
        kin=$(kube_path "$kc" "$home")
        [ "$kin" = "$kc" ] || set -- "$@" -e "KUBECONFIG=$kin"
      fi
      if [ -n "$as_home" ]; then
        set -- "$@" -e HOME=/aws --user "$(ls -nd "$home" | awk '{print $3 ":" $4}')"
      fi
      # shellcheck disable=SC2086 # both are intentionally word-split
      set -- "$@" ${DOCKER_ARGS:-} "$IMAGE" ${IMAGE_ARGS:-}
      # A spec's image_args: more of them, made from its env file (one a
      # line; ENV_FILE is the file), e.g. an endpoint in the server's region.
      if command -v image_args >/dev/null 2>&1; then
        _ifs=$IFS; IFS='
'; set -f
        # shellcheck disable=SC2046 # split on lines only
        set -- "$@" $(ENV_FILE="$dir/env" image_args)
        set +f; IFS=$_ifs
      fi
      printf '%s\n' "$@" | jq -Rn --arg name "$NAME" --arg desc "${DESCRIPTION:-}" \
        '{name: $name, description: $desc, transport: "stdio", command: "docker", args: [inputs], session_mode: "stateful"}' ;;
    http)
      url="${URL:-}"
      [ -n "${URL_VAR:-}" ] && url="$(envget "$URL_VAR" "$dir/env" | sed 's:/*$::')${URL_SUFFIX:-}"
      case "${AUTH:-none}" in
        basic)
          cred=$(printf '%s:%s' "$(envget "$AUTH_USER_VAR" "$dir/env")" "$(envget "$AUTH_TOKEN_VAR" "$dir/env")" | base64 | tr -d '\n')
          jq -n --arg name "$NAME" --arg desc "${DESCRIPTION:-}" --arg url "$url" --arg auth "Basic $cred" \
            '{name: $name, description: $desc, transport: "streamable_http", url: $url, headers: {Authorization: $auth}}' ;;
        bearer)
          jq -n --arg name "$NAME" --arg desc "${DESCRIPTION:-}" --arg url "$url" --arg tok "$(envget "$AUTH_TOKEN_VAR" "$dir/env")" \
            '{name: $name, description: $desc, transport: "streamable_http", url: $url, bearer_token: $tok}' ;;
        *)
          jq -n --arg name "$NAME" --arg desc "${DESCRIPTION:-}" --arg url "$url" \
            '{name: $name, description: $desc, transport: "streamable_http", url: $url}' ;;
      esac ;;
    *) echo "unknown KIND '$KIND'" >&2; return 1 ;;
  esac
}

# source [name ...] — where each server (these, else the enabled ones) runs
# from, a line each: <name> TAB <image or URL>, and for an image pulled
# here: TAB <its version label> TAB <its id> TAB <when it was built>.
if [ -n "$SOURCE" ]; then
  # shellcheck disable=SC2046 # names have no spaces (valid_name)
  [ $# -gt 0 ] || set -- $(enabled)
  for NAME in "$@"; do
    valid_name "$NAME" || continue
    spec=$(spec_for "$NAME")
    [ -n "$spec" ] || continue
    KIND= IMAGE= URL= URL_VAR= URL_SUFFIX=
    unset -f skeleton image_args 2>/dev/null || true
    # shellcheck disable=SC1090
    . "$spec"
    case "$KIND" in
      docker)
        # jq, not a template: one with no labels at all would fail it.
        here=$(docker image inspect --format '{{json .}}' "$IMAGE" 2>/dev/null |
          jq -r '[(.Config.Labels // {})["org.opencontainers.image.version"] // "", .Id, .Created] | @tsv' 2>/dev/null) || here=
        if [ -n "$here" ]; then printf '%s\t%s\t%s\n' "$NAME" "$IMAGE" "$here"; else printf '%s\t%s\n' "$NAME" "$IMAGE"; fi ;;
      http)
        url="${URL:-}"
        [ -n "${URL_VAR:-}" ] && url="$(envget "$URL_VAR" "$MCP_DIR/$NAME/env" | sed 's:/*$::')${URL_SUFFIX:-}"
        printf '%s\t%s\n' "$NAME" "$url" ;;
    esac
  done
  exit 0
fi

failed=0
want=$(enabled)
if live=$(mj --registry "$REGISTRY" list servers 2>/dev/null); then
  live=$(echo "$live" | sed -n 's/^[0-9][0-9]*\. //p')
elif [ -n "$STATUS" ]; then
  printf -- '-\tdown\t%s\n' "$REGISTRY"; live=
else
  echo "cannot reach the MCPJungle gateway at $REGISTRY" >&2; exit 1
fi
# state NAME STATE [DETAIL] — a status line.
state() { printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}"; }
[ -n "$STATUS" ] && [ -f "$MCP_DIR/off" ] && state '*' off

for NAME in $want; do
  spec=$(spec_for "$NAME")
  if [ -z "$spec" ]; then
    if [ -n "$STATUS" ]; then state "$NAME" nospec; continue; fi
    echo "$NAME: no spec (not in $CATALOG and no $MCP_DIR/$NAME/spec) — skipped"
    continue
  fi
  # Each spec's variables, none left from the one before (MOUNT_AWS
  # would give a server after an AWS one your ~/.aws).
  KIND= IMAGE= DOCKER_ARGS= HOST_ACCESS= IMAGE_ARGS= MOUNT_AWS= MOUNT_KUBE= REQUIRED= URL= URL_VAR= URL_SUFFIX= AUTH= AUTH_USER_VAR= AUTH_TOKEN_VAR= DESCRIPTION=
  unset -f skeleton image_args 2>/dev/null || true
  # shellcheck disable=SC1090
  . "$spec"
  # Another instance of a catalog server (grafana-prod, a link to
  # grafana.spec): its name leads the description, so agents tell them apart.
  case "${spec##*/}" in
    spec|"$NAME.spec") ;;
    *) DESCRIPTION="($NAME) ${DESCRIPTION:-}" ;;
  esac

  dir="$MCP_DIR/$NAME"
  if [ -n "$STATUS" ] && is_off "$NAME"; then
    if [ -f "$dir/off" ]; then state "$NAME" off own; else state "$NAME" off all; fi
    continue
  fi
  why=
  [ "$KIND" != docker ] || why=$(refusal "$NAME" "$spec")
  if [ -n "$why" ]; then
    if [ -n "$STATUS" ]; then state "$NAME" refused "$why"; continue; fi
    # One registered before its spec changed comes off the gateway.
    if [ -f "$dir/.registered.json" ]; then
      mj --registry "$REGISTRY" deregister "$NAME" >/dev/null 2>&1 || true
      rm -f "$dir/.registered.json" "$dir/.disabled"
    fi
    echo "$NAME: refused: its spec's Docker options include $why, which lets a container act as root on this machine — not registered"
    failed=1
    continue
  fi
  if [ -n "$STATUS" ] && [ ! -f "$dir/env" ]; then state "$NAME" noenv; continue; fi
  mkdir -p "$dir"; chmod 700 "$dir"
  if [ ! -f "$dir/env" ]; then
    if command -v skeleton >/dev/null 2>&1; then skeleton > "$dir/env"; else : > "$dir/env"; fi
    chmod 600 "$dir/env"
  fi

  missing=
  for key in $REQUIRED; do
    [ -n "$(envget "$key" "$dir/env")" ] || missing="$missing $key"
  done
  if [ -n "$missing" ]; then
    if [ -n "$STATUS" ]; then state "$NAME" waiting "${missing# }"; continue; fi
    echo "$NAME: waiting for credentials — fill in$missing in $dir/env (sudo yardo mcp edit $NAME)"
    continue
  fi

  if [ -n "$STATUS" ]; then
    # Registered as it is now; else changed since (or since it failed:
    # worth trying again), failed (why), or not registered.
    if ! render "$NAME" > "$dir/.config.json.status" 2>/dev/null; then
      rm -f "$dir/.config.json.status"; state "$NAME" failed "its settings don't make a config"; continue
    fi
    if [ -f "$dir/.registered.json" ] && cmp -s "$dir/.config.json.status" "$dir/.registered.json"; then
      if [ -z "$live" ] || echo "$live" | grep -qx "$NAME"; then state "$NAME" ok; else state "$NAME" unregistered; fi
    elif [ -f "$dir/.registered.json" ]; then
      state "$NAME" changed
    elif [ -f "$dir/.error" ] && [ "$dir/env" -nt "$dir/.error" ]; then
      state "$NAME" changed
    elif [ -f "$dir/.error" ]; then
      state "$NAME" failed "$(grep -v '^[[:space:]]*$' "$dir/.error" | head -n 3 | tr '\n\t' '  ' | sed 's/ *$//')"
    else
      state "$NAME" unregistered
    fi
    rm -f "$dir/.config.json.status"
    continue
  fi

  render "$NAME" > "$dir/.config.json.new"
  if [ -f "$dir/.registered.json" ] && cmp -s "$dir/.config.json.new" "$dir/.registered.json" \
     && echo "$live" | grep -qx "$NAME"; then
    rm -f "$dir/.config.json.new" "$dir/.error"
    echo "$NAME: up to date"
    continue
  fi
  if [ "$KIND" = docker ] && ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "$NAME: pulling $IMAGE"
    docker pull -q "$IMAGE" >/dev/null || {
      echo "$NAME: docker pull failed"; echo "couldn't pull $IMAGE" > "$dir/.error"; failed=1; continue; }
  fi
  out=$(mj --registry "$REGISTRY" register --force -c "$dir/.config.json.new" 2>&1) && rc=0 || rc=$?
  if [ "$rc" -eq 0 ]; then
    mv "$dir/.config.json.new" "$dir/.registered.json"
    rm -f "$dir/.error" "$dir/.disabled" # registering enables it
    if is_off "$NAME"; then echo "$NAME: registered, off"; else echo "$NAME: registered"; fi
  else
    rm -f "$dir/.config.json.new" "$dir/.registered.json" "$dir/.disabled"
    # Why, for status (and yardo) to say; kept until it registers.
    echo "$out" | grep -v '^TIP:' | grep -v '^[[:space:]]*$' > "$dir/.error" || echo "registration failed" > "$dir/.error"
    echo "$NAME: registration failed (check $dir/env):"
    sed 's/^/  /' "$dir/.error"
    failed=1
  fi
done

[ -n "$STATUS" ] && exit 0

# Deregister servers that were synced before but are no longer enabled.
for reg in "$MCP_DIR"/*/.registered.json; do
  [ -f "$reg" ] || continue
  NAME=$(basename "$(dirname "$reg")")
  if ! echo "$want" | grep -qx "$NAME"; then
    mj --registry "$REGISTRY" deregister "$NAME" >/dev/null 2>&1 || true
    rm -f "$reg" "$(dirname "$reg")/.disabled"
    echo "$NAME: deregistered (credentials kept in $MCP_DIR/$NAME)"
  fi
done

# Those turned off stay off: registering one enabled it again.
reconcile || { echo "the gateway didn't take every server's on or off; the next sync tries again" >&2; failed=1; }

exit "$failed"
