#!/bin/sh
# mcp-sync — register MCP servers into the local MCPJungle gateway.
#
#   mcp-sync [name ...]    enable these servers (saved to ~/.mcp/servers), then sync
#   mcp-sync               sync the saved list plus every ~/.mcp/<name>/spec
#   mcp-sync edit <name>   edit a server's credentials (~/.mcp/<name>/env)
#   mcp-sync rename <name> <new>  rename a server (deregistered; run mcp-sync to register it)
#   mcp-sync remove <name> deregister a server and delete its ~/.mcp/<name> (its settings)
#   mcp-sync status        each server's state, a line each: <name> TAB <state> TAB <detail>
#                          (ok, waiting <keys>, changed, unregistered, failed <why>,
#                          nospec, noenv; "-  down" first when the gateway can't be reached)
#   mcp-sync client <name> make a token for another MCP client (a laptop's agent), allowed
#                          every server; only when the gateway listens beyond this machine
#
# When yardo runs the gateway as a service user (mcp-<you>, which
# owns ~/.mcp so agents running as you can't read the tokens), this re-runs
# itself as that user through sudo. Nothing of the caller's environment
# crosses over: the home comes from the passwd entry, the catalog and the
# gateway's address are fixed, and the editor is a system one. (Else
# anyone running as you, a coding agent included, could have the service
# user source a spec of theirs, or send the tokens to a gateway of theirs.)
#
# Each server gets ~/.mcp/<name>/ (mode 700) holding its credentials in `env`
# (KEY=value lines, no quotes). Docker servers read that file at start; it is
# also mounted read-only at /mcp for servers that need extra files (e.g. AWS
# config). A server is registered once its required keys are filled in, and
# re-registered when its generated config changes. Servers dropped from the
# list are deregistered.
set -eu

me=$(id -un)
# This user's gateway port (yardo gives each user their own), and the
# address it listens on (all interfaces: reached here on loopback).
port=$(sed -n 's/^MCP_PORT=//p' "/etc/mcpjungle/$me.env" 2>/dev/null || true)
host=$(sed -n 's/^MCP_HOST=//p' "/etc/mcpjungle/$me.env" 2>/dev/null || true)
case "$host" in ''|0.0.0.0) host=127.0.0.1 ;; esac
# system_editor — the editor to edit as the service user with: yours when
# it's one of the usual ones installed for everyone, else vim, else vi.
system_editor() {
  for e in "${VISUAL:-}" "${EDITOR:-}" vim vi; do
    case "${e##*/}" in
      vim|vi|nvim|nano|emacs|micro|hx|mcedit) ;;
      *) continue ;;
    esac
    for d in /usr/bin /bin /usr/local/bin; do
      [ -x "$d/${e##*/}" ] && { echo "$d/${e##*/}"; return; }
    done
  done
  echo vi
}

if [ -z "${MCP_DIR:-}" ] && id "mcp-$me" >/dev/null 2>&1; then
  # The gateway's own record of its directory (root's), else the home's.
  dir=$(sed -n 's/^MCP_DIR=//p' "/etc/mcpjungle/$me.env" 2>/dev/null || true)
  if [ -z "$dir" ]; then
    home=$(getent passwd "$me" | cut -d: -f6)
    [ -n "$home" ] || { echo "mcp-sync: no home for $me" >&2; exit 1; }
    dir=$home/.mcp
  fi
  self=/usr/local/bin/mcp-sync
  [ -x "$self" ] || self=$0
  exec sudo -u "mcp-$me" env MCP_DIR="$dir" \
    MCP_CATALOG=/usr/local/share/mcp-catalog \
    MCPJUNGLE_REGISTRY="http://$host:${port:-8080}" \
    EDITOR="$(system_editor)" "$self" "$@"
fi

MCP_DIR="${MCP_DIR:-$HOME/.mcp}"
# The CLI reads the gateway's admin token (in enterprise mode) from
# $HOME/.mcpjungle.conf: the one in ~/.mcp, the service user's.
mj() { HOME="$MCP_DIR" mcpjungle "$@"; }
CATALOG="${MCP_CATALOG:-/usr/local/share/mcp-catalog}"
REGISTRY="${MCPJUNGLE_REGISTRY:-http://$host:${port:-8080}}"

umask 077
mkdir -p "$MCP_DIR"
chmod 700 "$MCP_DIR"

# valid_name NAME — a server name: a directory under $MCP_DIR, a gateway
# server name and its tools' prefix (<name>__<tool>).
valid_name() {
  case "$1" in
    ''|.*|-*|*[!A-Za-z0-9._-]*|*..*|*__*) return 1 ;;
  esac
  [ "${#1}" -le 64 ]
}

if [ "${1:-}" = edit ]; then
  valid_name "${2:-}" || { echo "usage: mcp-sync edit <server>" >&2; exit 2; }
  mkdir -p "$MCP_DIR/$2"
  chmod 700 "$MCP_DIR/$2"
  [ -f "$MCP_DIR/$2/env" ] || : > "$MCP_DIR/$2/env"
  chmod 600 "$MCP_DIR/$2/env"
  "${EDITOR:-vi}" "$MCP_DIR/$2/env"
  [ -n "${MCP_SYNC_QUIET:-}" ] || echo "Now run mcp-sync to register it (or: sudo yardo mcp sync)."
  exit 0
fi

if [ "${1:-}" = client ]; then
  case "${2:-}" in
    ''|.*|*/*|*[!A-Za-z0-9._-]*) echo "usage: mcp-sync client <name>" >&2; exit 2 ;;
  esac
  [ -f "$MCP_DIR/.mcpjungle.conf" ] || {
    echo "mcp-sync: the gateway listens on this machine only, with no tokens: choose another address in 'sudo yardo' first" >&2
    exit 1
  }
  mj --registry "$REGISTRY" create mcp-client "$2" --allow "*"
  echo "Send it as the header 'Authorization: Bearer <token>' to $REGISTRY/mcp (from another machine, use this machine's address)."
  exit 0
fi

# forget NAME — take NAME off the gateway (when it was registered) and off
# ~/.mcp/servers.
forget() {
  if [ -f "$MCP_DIR/$1/.registered.json" ]; then
    mj --registry "$REGISTRY" deregister "$1" >/dev/null 2>&1 || true
    rm -f "$MCP_DIR/$1/.registered.json"
  fi
  [ -f "$MCP_DIR/servers" ] && { grep -vx -- "$1" "$MCP_DIR/servers" > "$MCP_DIR/servers.new" || true; mv -f "$MCP_DIR/servers.new" "$MCP_DIR/servers"; }
  return 0
}

if [ "${1:-}" = rename ]; then
  { valid_name "${2:-}" && valid_name "${3:-}"; } || { echo "usage: mcp-sync rename <server> <new name>" >&2; exit 2; }
  [ -e "$MCP_DIR/$3" ] && { echo "mcp-sync: there's a $3 already" >&2; exit 1; }
  forget "$2"
  [ -d "$MCP_DIR/$2" ] && mv -- "$MCP_DIR/$2" "$MCP_DIR/$3"
  echo "$2 is $3 now; run mcp-sync to register it."
  exit 0
fi

if [ "${1:-}" = remove ]; then
  valid_name "${2:-}" || { echo "usage: mcp-sync remove <server>" >&2; exit 2; }
  forget "$2"
  rm -rf -- "${MCP_DIR:?}/$2"
  echo "$2: removed, with its settings."
  exit 0
fi

STATUS=
[ "${1:-}" = status ] && { STATUS=1; shift; }

if [ $# -gt 0 ] && [ -z "$STATUS" ]; then
  for n in "$@"; do
    valid_name "$n" || { echo "mcp-sync: not a server name: $n" >&2; exit 2; }
  done
  printf '%s\n' "$@" > "$MCP_DIR/servers"
fi

# envget KEY FILE — value of the last KEY=... line (comments ignored).
envget() { sed -n "s/^$1=//p" "$2" 2>/dev/null | tail -n 1; }

# spec_for NAME — the spec to source for NAME: its own ~/.mcp/<name>/spec
# (a file only this user can write, or a link into the catalog: a link
# leading anywhere else is refused), else the catalog's.
spec_for() {
  s="$MCP_DIR/$1/spec"
  if [ -L "$s" ]; then
    cat=$(cd "$CATALOG" 2>/dev/null && pwd -P) || return 0
    t=$(readlink -f "$s" 2>/dev/null) || return 0
    case "$t" in
      "$cat"/*.spec) [ -f "$t" ] && echo "$t" ;;
      *) echo "$1: its spec links outside $CATALOG — skipped" >&2 ;;
    esac
  elif [ -f "$s" ]; then echo "$s"
  elif [ -f "$CATALOG/$1.spec" ]; then echo "$CATALOG/$1.spec"
  fi
}

enabled() {
  { [ -f "$MCP_DIR/servers" ] && grep -v '^[[:space:]]*\(#\|$\)' "$MCP_DIR/servers"
    for s in "$MCP_DIR"/*/spec; do { [ -f "$s" ] || [ -L "$s" ]; } && basename "$(dirname "$s")"; done
  } | sort -u | while read -r n; do
    if valid_name "$n"; then echo "$n"; else echo "mcp-sync: not a server name, skipped: $n" >&2; fi
  done
}

# render NAME — print the MCPJungle JSON config for NAME (spec vars in scope).
render() {
  dir="$MCP_DIR/$1"
  case "$KIND" in
    docker)
      # DOCKER_ARGS go before the image, IMAGE_ARGS (the server's command
      # or flags) after it.
      # shellcheck disable=SC2086 # both are intentionally word-split
      set -- run -i --rm --env-file "$dir/env" -v "$dir:/mcp:ro" ${DOCKER_ARGS:-} "$IMAGE" ${IMAGE_ARGS:-}
      # A spec's image_args: more of them, made from its env file (one a
      # line; ENV_FILE is the file), e.g. an endpoint in the server's region.
      if command -v image_args >/dev/null 2>&1; then
        _ifs=$IFS; IFS='
'; set -f
        # shellcheck disable=SC2046 # split on lines only
        set -- "$@" $(ENV_FILE="$dir/env" image_args)
        set +f; IFS=$_ifs
      fi
      printf '%s\n' "$@" | jq -Rn --arg name "$NAME" --arg desc "${DESCRIPTION:-}" \
        '{name: $name, description: $desc, transport: "stdio", command: "docker", args: [inputs], session_mode: "stateful"}' ;;
    http)
      url="${URL:-}"
      [ -n "${URL_VAR:-}" ] && url="$(envget "$URL_VAR" "$dir/env" | sed 's:/*$::')${URL_SUFFIX:-}"
      case "${AUTH:-none}" in
        basic)
          cred=$(printf '%s:%s' "$(envget "$AUTH_USER_VAR" "$dir/env")" "$(envget "$AUTH_TOKEN_VAR" "$dir/env")" | base64 | tr -d '\n')
          jq -n --arg name "$NAME" --arg desc "${DESCRIPTION:-}" --arg url "$url" --arg auth "Basic $cred" \
            '{name: $name, description: $desc, transport: "streamable_http", url: $url, headers: {Authorization: $auth}}' ;;
        bearer)
          jq -n --arg name "$NAME" --arg desc "${DESCRIPTION:-}" --arg url "$url" --arg tok "$(envget "$AUTH_TOKEN_VAR" "$dir/env")" \
            '{name: $name, description: $desc, transport: "streamable_http", url: $url, bearer_token: $tok}' ;;
        *)
          jq -n --arg name "$NAME" --arg desc "${DESCRIPTION:-}" --arg url "$url" \
            '{name: $name, description: $desc, transport: "streamable_http", url: $url}' ;;
      esac ;;
    *) echo "unknown KIND '$KIND'" >&2; return 1 ;;
  esac
}

failed=0
want=$(enabled)
if live=$(mj --registry "$REGISTRY" list servers 2>/dev/null); then
  live=$(echo "$live" | sed -n 's/^[0-9][0-9]*\. //p')
elif [ -n "$STATUS" ]; then
  printf -- '-\tdown\t%s\n' "$REGISTRY"; live=
else
  echo "cannot reach the MCPJungle gateway at $REGISTRY" >&2; exit 1
fi
# state NAME STATE [DETAIL] — a status line.
state() { printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}"; }

for NAME in $want; do
  spec=$(spec_for "$NAME")
  if [ -z "$spec" ]; then
    if [ -n "$STATUS" ]; then state "$NAME" nospec; continue; fi
    echo "$NAME: no spec (not in $CATALOG and no $MCP_DIR/$NAME/spec) — skipped"
    continue
  fi
  KIND= IMAGE= DOCKER_ARGS= IMAGE_ARGS= REQUIRED= URL= URL_VAR= URL_SUFFIX= AUTH= AUTH_USER_VAR= AUTH_TOKEN_VAR= DESCRIPTION=
  unset -f skeleton image_args 2>/dev/null || true
  # shellcheck disable=SC1090
  . "$spec"
  # Another instance of a catalog server (grafana-prod, a link to
  # grafana.spec): its name leads the description, so agents tell them apart.
  case "${spec##*/}" in
    spec|"$NAME.spec") ;;
    *) DESCRIPTION="($NAME) ${DESCRIPTION:-}" ;;
  esac

  dir="$MCP_DIR/$NAME"
  if [ -n "$STATUS" ] && [ ! -f "$dir/env" ]; then state "$NAME" noenv; continue; fi
  mkdir -p "$dir"; chmod 700 "$dir"
  if [ ! -f "$dir/env" ]; then
    if command -v skeleton >/dev/null 2>&1; then skeleton > "$dir/env"; else : > "$dir/env"; fi
    chmod 600 "$dir/env"
  fi

  missing=
  for key in $REQUIRED; do
    [ -n "$(envget "$key" "$dir/env")" ] || missing="$missing $key"
  done
  if [ -n "$missing" ]; then
    if [ -n "$STATUS" ]; then state "$NAME" waiting "${missing# }"; continue; fi
    echo "$NAME: waiting for credentials — fill in$missing in $dir/env (sudo yardo mcp edit $NAME)"
    continue
  fi

  if [ -n "$STATUS" ]; then
    # Registered as it is now; else changed since (or since it failed:
    # worth trying again), failed (why), or not registered.
    if ! render "$NAME" > "$dir/.config.json.status" 2>/dev/null; then
      rm -f "$dir/.config.json.status"; state "$NAME" failed "its settings don't make a config"; continue
    fi
    if [ -f "$dir/.registered.json" ] && cmp -s "$dir/.config.json.status" "$dir/.registered.json"; then
      if [ -z "$live" ] || echo "$live" | grep -qx "$NAME"; then state "$NAME" ok; else state "$NAME" unregistered; fi
    elif [ -f "$dir/.registered.json" ]; then
      state "$NAME" changed
    elif [ -f "$dir/.error" ] && [ "$dir/env" -nt "$dir/.error" ]; then
      state "$NAME" changed
    elif [ -f "$dir/.error" ]; then
      state "$NAME" failed "$(grep -v '^[[:space:]]*$' "$dir/.error" | head -n 3 | tr '\n\t' '  ' | sed 's/ *$//')"
    else
      state "$NAME" unregistered
    fi
    rm -f "$dir/.config.json.status"
    continue
  fi

  render "$NAME" > "$dir/.config.json.new"
  if [ -f "$dir/.registered.json" ] && cmp -s "$dir/.config.json.new" "$dir/.registered.json" \
     && echo "$live" | grep -qx "$NAME"; then
    rm -f "$dir/.config.json.new" "$dir/.error"
    echo "$NAME: up to date"
    continue
  fi
  if [ "$KIND" = docker ] && ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "$NAME: pulling $IMAGE"
    docker pull -q "$IMAGE" >/dev/null || {
      echo "$NAME: docker pull failed"; echo "couldn't pull $IMAGE" > "$dir/.error"; failed=1; continue; }
  fi
  out=$(mj --registry "$REGISTRY" register --force -c "$dir/.config.json.new" 2>&1) && rc=0 || rc=$?
  if [ "$rc" -eq 0 ]; then
    mv "$dir/.config.json.new" "$dir/.registered.json"
    rm -f "$dir/.error"
    echo "$NAME: registered"
  else
    rm -f "$dir/.config.json.new" "$dir/.registered.json"
    # Why, for status (and yardo) to say; kept until it registers.
    echo "$out" | grep -v '^TIP:' | grep -v '^[[:space:]]*$' > "$dir/.error" || echo "registration failed" > "$dir/.error"
    echo "$NAME: registration failed (check $dir/env):"
    sed 's/^/  /' "$dir/.error"
    failed=1
  fi
done

[ -n "$STATUS" ] && exit 0

# Deregister servers that were synced before but are no longer enabled.
for reg in "$MCP_DIR"/*/.registered.json; do
  [ -f "$reg" ] || continue
  NAME=$(basename "$(dirname "$reg")")
  if ! echo "$want" | grep -qx "$NAME"; then
    mj --registry "$REGISTRY" deregister "$NAME" >/dev/null 2>&1 || true
    rm -f "$reg"
    echo "$NAME: deregistered (credentials kept in $MCP_DIR/$NAME)"
  fi
done

exit "$failed"
