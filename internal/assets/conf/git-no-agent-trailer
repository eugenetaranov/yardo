#!/bin/sh
# yardo: drops the lines a coding agent adds to a commit message (a
# Co-authored-by for Claude, Codex, Cursor, Gemini, OpenCode, Goose, Aider,
# Copilot, Amp and the like; a "Generated with" footer; Amp's thread link)
# and nothing else: a person's Co-authored-by stays. Git runs it as a
# commit-msg hook (git config hook.yardo-no-agent-trailer.*): $1 is the
# message file.
f=${1:-}
[ -n "$f" ] && [ -f "$f" ] || exit 0
tmp=$(mktemp "$f.XXXXXX") || exit 0
grep -Eiv '^[[:space:]]*co-authored-by:[[:space:]]*(claude|codex|cursor|gemini|opencode|goose|aider|copilot|github copilot|devin|jules|windsurf|cline|junie|openhands|qwen|crush)([[:space:]<(]|$)|^[[:space:]]*co-authored-by:.*(noreply@anthropic\.com|noreply@openai\.com|cursoragent@cursor\.com|noreply@aider\.chat|noreply@opencode\.ai|amp@ampcode\.com|copilot@users\.noreply\.github\.com|devin-ai-integration|noreply@google\.com)|^[[:space:]]*amp-thread(-id)?:|^[[:space:]]*(🤖[[:space:]]*)?generated (with|by) \[?(claude|codex|cursor|gemini|opencode|goose|aider|copilot|github copilot|devin|jules|windsurf|cline|junie|openhands|qwen|crush|claude code|gemini cli|amp)\]?' "$f" |
  awk '{ l[NR] = $0 } END { n = NR; while (n > 0 && l[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print l[i] }' > "$tmp"
# Unchanged: leave the file alone (its mode, its links).
if cmp -s "$tmp" "$f"; then rm -f "$tmp"; exit 0; fi
cat "$tmp" > "$f"
rm -f "$tmp"
