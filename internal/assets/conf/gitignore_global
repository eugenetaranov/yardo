# Global git ignores for every repo (yardo's "Git defaults"). A repo can
# still track one: `!.claude/` in its .gitignore, or `git add -f <path>`.

# OS and editors
.DS_Store
Thumbs.db
ehthumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# AI coding agents' per-machine state
.claude/
.aider*

# Python
.python-version
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Environment and secrets (examples stay tracked)
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc
.direnv/

# JavaScript
node_modules/
npm-debug.log*

# Go: test binaries, coverage, local workspaces
*.test
coverage.out
coverage.html
go.work
go.work.sum

# Playwright
test-results/
playwright-report/
blob-report/

# Terraform: working dirs, the lock file too (`git add -f
# .terraform.lock.hcl` to pin providers), local state, crash logs
.terraform*
terraform.tfstate*
crash.log
crash.*.log
