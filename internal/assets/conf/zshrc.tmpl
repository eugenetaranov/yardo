export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="{{ .yardo_zsh_theme }}"

# Powerlevel10k instant prompt: the prompt appears at once while the rest
# loads. Only with the p10k theme and once p10k has written its cache.
if [[ $ZSH_THEME == powerlevel10k/* && -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Completions for installed tools that have no oh-my-zsh plugin (cached;
# see the file). Before oh-my-zsh, which runs compinit.
[ -f ~/.config/yardo/completions.zsh ] && source ~/.config/yardo/completions.zsh

# Plugins follow what is installed: a tool's plugin loads only when the
# tool is on PATH, so tools added later are picked up by the next shell.
plugins=(git wd sudo extract colored-man-pages zsh-fzf-history-search)
() {
  local p t
  for p t in aws aws terraform terraform opentofu tofu kubectl kubectl \
             kubectx kubectx helm helm docker docker gh gh mise mise \
             rust rustup golang go; do
    (( $+commands[$t] )) && plugins+=($p)
  done
}
[ -d "$ZSH/custom/plugins/fzf-tab" ] && plugins+=(fzf-tab)
plugins+=(zsh-autosuggestions zsh-syntax-highlighting) # syntax-highlighting last
source "$ZSH/oh-my-zsh.sh"

(( $+functions[yardo_bash_completers] )) && yardo_bash_completers

if (( ${plugins[(Ie)fzf-tab]} )); then
  # fzf-tab draws the menu: turn off oh-my-zsh's menu select, which is set
  # on the more specific pattern and would otherwise win.
  zstyle ':completion:*' menu no
  zstyle ':completion:*:*:*:*:*' menu no
  (( $+commands[eza] )) && zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
fi

export EDITOR=vim

# The prompt: Powerlevel10k (`p10k configure` restyles it, in ~/.p10k.zsh)
# or, with no theme, Starship (~/.config/starship.toml).
if [[ $ZSH_THEME == powerlevel10k/* ]]; then
  [ -f ~/.p10k.zsh ] && source ~/.p10k.zsh
elif [[ -z $ZSH_THEME ]] && (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

# yardo: local overrides (keep last)
# Your own settings go in ~/.zshrc.local: yardo never writes it, and
# rewrites this file on a re-run (your first .zshrc is kept as .zshrc.orig).
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
