#!/bin/sh
# mcp-audit — each MCP server spec's pin next to its upstream's latest
# release, for the audit before a minor release (see README, Development).
# It changes nothing: a newer release is for a person to read and pin.
#
#   scripts/mcp-audit          every spec, a line each: spec, what, pinned, latest
#
# Needs curl and jq. GITHUB_TOKEN, when set, raises GitHub's rate limit.
set -eu
cd "$(dirname "$0")/.."

gh() {
  curl -fsS ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} "https://api.github.com/repos/$1/releases/latest" 2>/dev/null |
    jq -r '.tag_name // "?"' 2>/dev/null || echo "?"
}
npm() { curl -fsS "https://registry.npmjs.org/$1/latest" 2>/dev/null | jq -r '.version // "?"' 2>/dev/null || echo "?"; }
pypi() { curl -fsS "https://pypi.org/pypi/$1/json" 2>/dev/null | jq -r '.info.version // "?"' 2>/dev/null || echo "?"; }
# node's newest release on the pinned major line, with -slim.
node_line() {
  curl -fsS https://nodejs.org/dist/index.json 2>/dev/null |
    jq -r --arg m "v$1." '[.[] | select(.version | startswith($m))][0].version // "?" | ltrimstr("v")' 2>/dev/null || echo "?"
}
# MCR keeps no releases: its newest plain version tag.
mcr() {
  curl -fsS "https://mcr.microsoft.com/v2/$1/tags/list" 2>/dev/null |
    jq -r '[.tags[] | select(test("^v?[0-9]+\\.[0-9]+\\.[0-9]+$"))] | sort_by(ltrimstr("v") | split(".") | map(tonumber)) | last // "?"' 2>/dev/null || echo "?"
}

# The GitHub repository whose releases an image follows.
repo_of() {
  case $1 in
    ghcr.io/github/github-mcp-server) echo github/github-mcp-server ;;
    ghcr.io/korotovsky/slack-mcp-server) echo korotovsky/slack-mcp-server ;;
    ghcr.io/sooperset/mcp-atlassian) echo sooperset/mcp-atlassian ;;
    ghcr.io/astral-sh/uv) echo astral-sh/uv ;;
    grafana/mcp-grafana) echo grafana/mcp-grafana ;;
    flux159/mcp-server-kubernetes) echo Flux159/mcp-server-kubernetes ;;
    crystaldba/postgres-mcp) echo crystaldba/postgres-mcp ;;
    mcr.microsoft.com/playwright/mcp) echo microsoft/playwright-mcp ;;
    public.ecr.aws/mcp-proxy-for-aws/mcp-proxy-for-aws) echo aws/mcp-proxy-for-aws ;;
  esac
}

row() { printf '%-20s %-56s %-30s %s\n' "$1" "$2" "$3" "$4"; }

row SPEC WHAT PINNED LATEST
for f in internal/assets/conf/mcp-catalog/*.spec internal/assets/mcp-catalog/*.spec; do
  n=$(basename "$f" .spec)
  image=$(sed -n 's/^IMAGE=//p' "$f")
  if [ -n "$image" ]; then
    name=${image%:*} tag=${image##*:}
    case $name in
      node) latest=$(node_line "${tag%%.*}")-slim ;;
      mcr.microsoft.com/azure-sdk/azure-mcp) latest=$(mcr azure-sdk/azure-mcp) ;;
      *)
        r=$(repo_of "$name")
        latest=${r:+$(gh "$r")}
        latest=${latest:-"? (no upstream known: add it to repo_of)"}
        case $name in ghcr.io/astral-sh/uv) latest="$latest${tag#"${tag%%-*}"}" ;; esac
        ;;
    esac
    row "$n" "$name" "$tag" "$latest"
  fi
  # A package it runs: npx -y <pkg>@<v>, or uvx <pkg>@<v> (in image_args,
  # a line each).
  tr '\n' ' ' < "$f" | sed 's/echo uvx *echo /uvx /g' |
    grep -oE '(npx -y|uvx) +@?[a-z0-9][a-z0-9._/-]*@[0-9][^ "]*' | while read -r how pkg; do
    pkg=${pkg#-y } name=${pkg%@*} ver=${pkg##*@}
    case $how in
      npx) row "$n" "npm $name" "$ver" "$(npm "$name")" ;;
      uvx) row "$n" "pypi $name" "$ver" "$(pypi "$name")" ;;
    esac
  done
done
